{
  "name": "js-ts-playwright-framework",
  "version": "1.2.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "format:write": "prettier . --write",
    "format:check": "prettier . --check",
    "pretest": "npm run clean:reports",
    "test": "cucumber-js -p allure",
    "posttest": "npm run allure",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure": "npm run allure:generate && npm run allure:open",
    "clean:reports": "rimraf allure-results allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@eslint/js": "^8.57.0",
    "@playwright/test": "^1.56.1",
    "@types/cucumber": "^6.0.1",
    "@types/node": "^20.19.11",
    "@typescript-eslint/eslint-plugin": "^8.12.1",
    "@typescript-eslint/parser": "^8.12.1",
    "allure-commandline": "^2.34.1",
    "allure-cucumberjs": "^3.4.2",
    "allure-playwright": "^3.4.2",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "globals": "^15.15.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
