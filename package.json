{
  "name": "js-ts-playwright-framework",
  "version": "1.2.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "format:write": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "cucumber-js --format progress, @cucumber/pretty-formatter",
    "test:allure": "cucumber-js ",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "test:full": "npm run test:allure && npm run allure:generate && npm run allure:open",
    "test:report": "npm run test:allure && npm run allure:serve",
    "clean:reports": "rimraf allure-results && rimraf allure-report",
    "test:govsearch": "cucumber-js --tags '@govsearch'  && npm run allure:generate",
    "test:smoke": "cucumber-js --tags '@smoke'  && npm run allure:generate",
    "test:visa": "cucumber-js --tags '@visa'  && npm run allure:generate",
    "test:wikisearch": "cucumber-js --tags '@wikisearch'  && npm run allure:generate",
    "test:govsearch:open": "npm run test:govsearch && npm run allure:open",
    "test:smoke:open": "npm run test:smoke && npm run allure:open",
    "test:visa:open": "npm run test:visa && npm run allure:open",
    "test:wikisearch:open": "npm run test:wikisearch && npm run allure:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@eslint/js": "^8.57.0",
    "@playwright/test": "^1.56.1",
    "@types/cucumber": "^6.0.1",
    "@types/node": "^20.19.11",
    "allure-commandline": "^2.34.1",
    "allure-cucumberjs": "^3.4.2",
    "allure-playwright": "^3.4.2",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.0",
    "globals": "^15.15.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^7.18.0"
  }
}
