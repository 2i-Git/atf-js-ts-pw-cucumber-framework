{
  "name": "js-ts-playwright-framework",
  "version": "1.2.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "format:write": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "playwright test",
    "test:allure": "rimraf allure-results && playwright test --reporter=allure-playwright",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "clean:reports": "rimraf allure-results allure-report",
    "allure:full": "npm run clean:reports && npm run test:allure && npm run allure:generate && npm run allure:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.19.24",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.2",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.0",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.18.0"
  },
  "dependencies": {
    "playwright": "^1.54.2"
  }
}
