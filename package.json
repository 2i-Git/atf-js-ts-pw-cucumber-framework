{
  "name": "js-ts-playwright-framework",
  "version": "1.2.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "format:write": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "cucumber-js --format progress --exit",
    "test:allure": "cucumber-js  allure-cucumberjs/reporter --exit",
    "allure:generate": "allure generate allure-results --clean -o allure-report ",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "test:full": "cucumber-js --exit  && npm run allure:generate && npm run allure:open ",
    "test:report": "npm run test:allure && npm run allure:serve"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@eslint/js": "^8.57.0",
    "@playwright/test": "^1.56.1",
    "@types/cucumber": "^6.0.1",
    "@types/node": "^20.19.11",
    "allure-commandline": "^2.34.1",
    "allure-cucumberjs": "^3.4.2",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.0",
    "globals": "^15.15.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^7.18.0"
  }
}
