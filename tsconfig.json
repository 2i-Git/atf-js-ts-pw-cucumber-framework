{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "baseUrl": ".",
    "types": ["node", "@playwright/test"],
    "paths": {
      "@components/*": ["components/*"],
      "@enums/*": ["enums/*"],
      "@fixtures/*": ["fixtures/*"],
      "@helpers/*": ["helpers/*"],
      "@models/*": ["models/*"],
      "@pages/*": ["pages/*"]
    }
  },
  "include": ["features/**/*.ts", "**/*.ts"]
}
