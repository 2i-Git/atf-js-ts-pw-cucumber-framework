{
  "default": {
    "require": ["features/**/*.ts", "support/**/*.ts"],
    "requireModule": ["ts-node/register"],
    "format": ["progress"],
    "publishQuiet": true
  },
  "allure": {
    "require": ["features/**/*.ts", "support/**/*.ts"],
    "requireModule": ["ts-node/register"],
    "format": ["allure-cucumberjs/reporter"],
    "publishQuiet": true
  }
}
